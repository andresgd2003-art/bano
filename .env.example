# Copia a .env y rellena. .env está en .gitignore y NUNCA se commitea.

# --- Endpoint de BANO ---
BANO_BEARER_TOKEN=          # token que la plataforma envía en Authorization: Bearer
BANO_BASE_URL=              # https://<host>/webhook/bano/v1  (la plataforma le anade /responses)

# --- Modelos (NVIDIA, plan gratuito) ---
NVIDIA_API_KEY=             # nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
# Embeddings: OpenAI, no NVIDIA (ADR-0009). Sus modelos son asimetricos y el
# nodo de n8n no puede enviarles input_type.
OPENAI_EMBED_MODEL=text-embedding-3-small   # 1536 dimensiones

# --- Postgres + pgvector (servicio dedicado de BANO) ---
BANO_PG_HOST=
BANO_PG_PORT=5432
BANO_PG_DB=bano
BANO_PG_USER=
BANO_PG_PASSWORD=

# --- n8n ---
N8N_BASE_URL=               # host de la instancia
N8N_API_KEY=
